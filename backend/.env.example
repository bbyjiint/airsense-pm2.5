# App Configuration
PORT=4000
NODE_ENV=production

# Security & CORS (comma-separated origins, or * for all)
CORS_ORIGIN=https://airsense.yourdomain.com,https://airsense-preview.vercel.app

# Database Configuration (MySQL)
# Option 1: URL format
# DATABASE_URL=mysql://root:password@localhost:3306/airsense_db

# Option 2: Individual variables
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=airsense_db

# Database Connection Pool Tuning (Production)
DB_CONNECTION_LIMIT=20
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT=60000
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true
